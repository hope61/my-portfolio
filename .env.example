# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# WARNING: any variable prefixed with VITE_ is inlined into the public
# frontend bundle and is readable by anyone who visits the site.
# Never put a secret behind a VITE_ prefix.


# --- Frontend (build-time, PUBLIC) ---------------------------------------

# Backend origin used only during `vite dev`. Production builds ignore this
# and call /api/ same-origin, which nginx proxies to the backend container.
# Leave empty to talk to a backend running on the same host/port as Vite.
VITE_API_BASE_URL=https://portfolio-api.dicki.org


# --- Proxmox VE (runtime, PRIVATE) ---------------------------------------

# Base URL of the Proxmox web API, including port.
PVE_HOST=https://<pve-host>:8006

# Node name as shown in the PVE UI (`pvesh get /nodes` lists them).
PVE_NODE=pve

# Read-only API token. Create it on the node with:
#   pveum user add portfolio@pve
#   pveum user token add portfolio@pve readonly --privsep 1
#   pveum acl modify /nodes/<node> --users portfolio@pve --roles PVEAuditor
#   pveum acl modify /nodes/<node> --tokens 'portfolio@pve!readonly' --roles PVEAuditor
# BOTH grants are required. With --privsep 1 the token's effective rights are
# the INTERSECTION of the user's and the token's; granting only one gives none.
# Single-quote the token id - the '!' triggers shell history expansion.
PVE_TOKEN_ID=portfolio@pve!readonly
PVE_TOKEN_SECRET=

# TLS. Proxmox ships a self-signed cert, so pin its CA rather than turning
# verification off: copy /etc/pve/pve-root-ca.pem off the node and point here.
PVE_CA_PATH=
# Last resort only - disables certificate checking entirely (MITM risk).
PVE_VERIFY_SSL=true

# Storage IDs to total for the "disk" figure, comma-separated (e.g. local,data).
# Leave empty to report the node's root filesystem instead. Name them
# explicitly; summing every store double-counts disks that back more than one.
PVE_STORAGE=

# How long the backend caches an upstream response, in seconds.
STATS_CACHE_SECONDS=30

# Extra CORS origins beyond the built-in allowlist, comma-separated.
# Useful for LAN/phone testing, e.g. http://192.168.0.42:5173
CORS_EXTRA_ORIGINS=


# --- Docker Compose host port mappings -----------------------------------

FRONTEND_PORT=3002
BACKEND_PORT=5437
